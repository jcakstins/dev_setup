# Generated by `chezmoi init` (bootstrap.sh runs it once). Edit
# ~/.config/chezmoi/chezmoi.toml to change values on one machine.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    # Personal identity by default; on a work Mac set DOTFILES_GIT_EMAIL=you@work.com
    # before the first bootstrap, or edit this value afterwards.
    email = {{ env "DOTFILES_GIT_EMAIL" | default "janis.cakstins@gmail.com" | quote }}
