#!/usr/bin/env bash
# Install the tool versions declared in ~/.config/mise/config.toml.
# Re-runs automatically when that file changes.
# config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail
log()  { printf "\033[0;32m==>\033[0m %s\n" "$*"; }
info() { printf "\033[0;34m   →\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[warn]\033[0m %s\n" "$*"; }

export PATH="/opt/homebrew/bin:$PATH"
if ! command -v mise &>/dev/null; then
  warn "mise not found — is it in the Brewfile? Skipping tool install."
  exit 1
fi

# Authenticated GitHub requests avoid the 60/h anonymous rate limit
if [[ -z "${MISE_GITHUB_TOKEN:-}" ]] && command -v gh &>/dev/null && gh auth token &>/dev/null; then
  export MISE_GITHUB_TOKEN="$(gh auth token)"
fi

log "mise — installing tools"
mise install --yes
mise ls --current
