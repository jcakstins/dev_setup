#!/usr/bin/env bash
# Install Cursor / VS Code extensions. Re-runs automatically when the list
# in .chezmoitemplates/cursor-extensions.txt changes.
set -euo pipefail
log()  { printf "\033[0;32m==>\033[0m %s\n" "$*"; }
info() { printf "\033[0;34m   →\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[warn]\033[0m %s\n" "$*"; }

EXTENSIONS=$(cat <<'LIST'
{{ template "cursor-extensions.txt" . }}
LIST
)

install_extensions() {
  local cli="$1" label="$2"
  if ! command -v "$cli" &>/dev/null; then
    warn "${label} CLI '${cli}' not found — skipping"
    return 0
  fi
  log "${label} extensions"
  local installed; installed="$("$cli" --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
  local ext
  while IFS= read -r ext; do
    [[ -z "$ext" || "$ext" =~ ^[[:space:]]*# ]] && continue
    if grep -qix "$ext" <<<"$installed"; then
      info "$ext (already installed)"
    else
      info "Installing $ext..."
      "$cli" --install-extension "$ext" --force &>/dev/null || warn "Failed to install $ext"
    fi
  done <<<"$EXTENSIONS"
}

install_extensions cursor Cursor
install_extensions code "VS Code"
